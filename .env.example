DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# LLM, optional. The app keeps working with fallback summaries if this is missing.
OPENAI_API_KEY=""

# Email, optional for local demo. Missing values create notification log entries instead of crashing.
EMAIL_FROM="Clinic Desk <clinic@example.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Google Calendar, optional. Use OAuth credentials for a doctor/admin-connected calendar.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# Protects /api/cron/reminders when deployed.
CRON_SECRET="local-demo-secret"
